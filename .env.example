# PostgreSQL Database Configuration
REACT_APP_PGHOST=your-database-host
REACT_APP_PGDATABASE=your-database-name
REACT_APP_PGUSER=your-database-user
REACT_APP_PGPASSWORD=your-database-password
REACT_APP_PGSSLMODE=require
REACT_APP_PGCHANNELBINDING=require

# API Configuration
REACT_APP_API_BASE_URL=http://localhost:8080

# Chatbot Configuration (if using external API)
REACT_APP_CHATBOT_API_KEY=your-chatbot-api-key

# Form Services (if using Formspree or similar)
REACT_APP_FORMSPREE_ID=your-formspree-id
